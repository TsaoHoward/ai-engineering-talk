{
  "name": "@ai-engineering-talk/synthetic-order-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "worker:init": "msw init public --save",
    "dev": "npm run worker:init && vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run worker:init && npm run typecheck && vite build",
    "preview": "vite preview",
    "test:e2e": "node --test test/browser.test.mjs",
    "verify": "npm run build && npm run test:e2e"
  },
  "dependencies": {
    "drizzle-orm": "0.44.7",
    "msw": "2.13.4"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "playwright": "1.59.0",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
